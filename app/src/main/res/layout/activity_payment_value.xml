<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="R$ 0,00"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:id="@+id/numpad_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="3"
        app:layout_constraintTop_toBottomOf="@id/tv_amount">

        <Button
            android:id="@+id/btn1"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="3" />

        <Button
            android:id="@+id/btn4"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="6" />

        <Button
            android:id="@+id/btn7"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="9" />

        <ImageButton
            android:id="@+id/btnCalculator"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:src="@drawable/baseline_calculate_24" />

        <Button
            android:id="@+id/btn0"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="0" />

        <Button
            android:id="@+id/btnBack"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="⌫" />
    </GridLayout>

    <GridLayout
        android:id="@+id/payment_methods_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2"
        app:layout_constraintTop_toBottomOf="@id/numpad_grid">

        <Button
            android:id="@+id/btnCreditoAvista"
            style="@style/PrimaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Crédito à Vista" />

        <Button
            android:id="@+id/btnCreditoParcelado"
            style="@style/PrimaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Crédito Parc." />

        <Button
            android:id="@+id/btnDebito"
            style="@style/PrimaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Débito" />

        <Button
            android:id="@+id/btnPix"
            style="@style/PrimaryActionButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Pix" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>